#!/usr/bin/env python3
"""Apply Hyprsunset settings to one unambiguous Hyprland session."""

import json
import os
from pathlib import Path
import subprocess
import sys
import time


def main() -> int:
    if sys.argv[1:] != ["identity"] and not (
        len(sys.argv) == 3 and sys.argv[1] == "temperature" and sys.argv[2].isdigit()
        and 1000 <= int(sys.argv[2]) <= 20000
    ):
        print("Usage: hyprsunset-set identity | temperature 1000..20000", file=sys.stderr)
        return 2
    try:
        runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
        result = subprocess.run(["hyprctl", "-j", "instances"], capture_output=True, text=True, check=True, timeout=5)
        # Hyprland 0.56 emits a lone closing bracket when no instances exist.
        instances = [] if result.stdout.strip() == "]" else json.loads(result.stdout)
        if not isinstance(instances, list):
            raise ValueError("invalid Hyprland instance list")
        signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        display = os.environ.get("WAYLAND_DISPLAY")
        candidates = []
        for instance in instances:
            sig, wayland = instance["instance"], instance["wl_socket"]
            if signature and sig != signature:
                continue
            if display and Path(display).name != wayland:
                continue
            if (runtime / "hypr" / sig / ".socket.sock").is_socket() and (runtime / wayland).is_socket():
                candidates.append(instance)
        if not candidates:
            # Persistent timers can run before login or after logout.
            return 0
        if len(candidates) != 1:
            raise ValueError("ambiguous Hyprland session; set HYPRLAND_INSTANCE_SIGNATURE or WAYLAND_DISPLAY")
        instance = candidates[0]
        os.environ.update(XDG_RUNTIME_DIR=str(runtime), WAYLAND_DISPLAY=instance["wl_socket"],
                          HYPRLAND_INSTANCE_SIGNATURE=instance["instance"])
        subprocess.run(["systemctl", "--user", "import-environment", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR",
                        "HYPRLAND_INSTANCE_SIGNATURE"], check=True, timeout=5)
        subprocess.run(["systemctl", "--user", "start", "hyprsunset.service"], check=True, timeout=10)
        socket = runtime / "hypr" / instance["instance"] / ".hyprsunset.sock"
        deadline = time.monotonic() + 5
        while not socket.is_socket():
            if time.monotonic() >= deadline:
                raise RuntimeError("timed out waiting for Hyprsunset IPC socket")
            subprocess.run(["systemctl", "--user", "is-active", "--quiet", "hyprsunset.service"], check=True, timeout=2)
            time.sleep(0.05)
        subprocess.run(["hyprctl", "hyprsunset", *sys.argv[1:]], check=True, timeout=5)
    except (OSError, ValueError, KeyError, TypeError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"[ERROR] {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
