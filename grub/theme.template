# Generated by generate-theme.py from theme.template and sizes.json. Do not edit.
# Midnight Terminal: Alacritty palette, with the personal dark-blue accent.
title-text: ""
desktop-color: "#000000"
desktop-image: "background.png"
desktop-image-scale-method: "crop"
terminal-font: "UbuntuMono Nerd Font Regular ${terminal}"
terminal-box: "console_*.png"
terminal-border: "8"
terminal-left: "6%"
terminal-top: "6%"
terminal-width: "88%"
terminal-height: "80%"

+ image {
  left = 3%
  top = 3%
  width = 94%
  height = 2
  file = "terminal-edge.png"
}
+ image {
  left = 3%
  top = 3%
  width = 2
  height = 94%
  file = "terminal-edge.png"
}
+ image {
  left = 97%-2
  top = 3%
  width = 2
  height = 94%
  file = "terminal-edge.png"
}
+ image {
  left = 3%
  top = 97%-2
  width = 94%
  height = 2
  file = "terminal-edge.png"
}
+ label {
  left = 3%+18
  top = 32%
  width = 94%-36
  height = ${title_height}
  text = "Select an operating system or an option"
  font = "UbuntuMono Nerd Font Bold ${title}"
  color = "#4fb8cc"
  align = "center"
}
+ boot_menu {
  left = ${menu_left}
  top = 32%+${menu_offset}
  width = ${menu_width}
  height = ${menu_height}
  item_font = "UbuntuMono Nerd Font Regular ${menu}"
  selected_item_font = "UbuntuMono Nerd Font Regular ${menu}"
  item_color = "#ffffff"
  selected_item_color = "#ffffff"
  icon_width = ${icon}
  icon_height = ${icon}
  item_icon_space = ${icon_gap}
  item_height = ${row}
  item_padding = ${padding}
  item_spacing = ${spacing}
  scrollbar = false
  scrollbar_left_pad = 0
  selected_item_pixmap_style = "midnight-select_*.png"
}
+ label {
  id = "__timeout__"
  left = 3%+18
  top = 32%+${counter_offset}
  width = 94%-36
  height = ${footer_height}
  text = "Booting in %d s"
  font = "UbuntuMono Nerd Font Footer Regular ${footer}"
  color = "#f3e430"
  align = "center"
}
# Center complete key/label groups in equal fifths of the inner panel width.
+ canvas {
  left = 3%+16
  top = 97%-${footer_offset}
  width = 94%-32
  height = ${canvas_height}
${hints}}

# GRUB 2.14 canvas_add prepends children: last declared is painted first.
# Keep the wallpaper alpha panel behind all text, icons and the help canvas.
+ image {
  left = 3%+2
  top = 3%+2
  width = 94%-4
  height = 94%-4
  file = "panel.png"
}
