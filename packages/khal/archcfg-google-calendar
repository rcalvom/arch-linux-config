#!/usr/bin/env bash
set -euo pipefail

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
config_file="$config_home/vdirsyncer/config"
token_file="$config_home/vdirsyncer/google-token.json"
calendar_dir="$data_home/vdirsyncer/calendars"

[[ -f "$config_file" ]] || {
  printf 'Google Calendar is not configured. Run archcfg-vdirsyncer-setup first.\n' >&2
  exit 1
}

umask 077
if ! vdirsyncer --config "$config_file" sync; then
  printf 'Google Calendar sync failed; opening the cached local mirror.\n' >&2
fi

[[ -d "$calendar_dir" ]] || {
  printf 'Google Calendar mirror is not initialized. Run vdirsyncer discover, then vdirsyncer sync.\n' >&2
  exit 1
}

[[ ! -f "$token_file" ]] || chmod 600 "$token_file"
exec khal interactive
