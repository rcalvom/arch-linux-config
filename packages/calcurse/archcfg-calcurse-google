#!/usr/bin/env bash
set -euo pipefail

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
state_home=${XDG_STATE_HOME:-"$HOME/.local/state"}
vdir_config="$config_home/vdirsyncer/config"
calendar_dir="$data_home/vdirsyncer/calendars"
calcurse_config_dir="$config_home/calcurse"
calcurse_data_dir="$data_home/calcurse"
profile_dir="$data_home/archcfg/calcurse-google"
generations_dir="$profile_dir/generations"
current_profile="$profile_dir/current"
reminder_profile="$data_home/archcfg/calcurse-google-reminders"
state_dir="$state_home/archcfg"
profile_lock_file="$state_dir/calcurse-google-refresh.lock"
session_lock_file="$state_dir/calcurse-google-session.lock"
build_dir=
file_list=
import_config_dir=
session_dir=
calcurse_pid=
terminal_monitor_pid=
refresh_only=false

print_header() {
    "$refresh_only" && return 0

    if [[ -t 1 ]]; then
        printf '\n  \033[1;36m📅 Calendar Sync\033[0m\n'
    else
        printf '\n  📅 Calendar Sync\n'
    fi
}

print_status() {
    local color=$1
    local icon=$2
    local message=$3

    "$refresh_only" && return 0

    if [[ -t 1 ]]; then
        printf '  \033[%sm%s %s\033[0m\n' "$color" "$icon" "$message"
    else
        printf '  %s %s\n' "$icon" "$message"
    fi
}

copy_todo_notes() {
    local todo_file=$1
    local source_dir=$2
    local destination_dir=$3
    local note_reference
    local note_hash

    [[ -f "$todo_file" && -d "$source_dir" ]] || return 0
    install -dm700 "$destination_dir" || return 1

    while IFS= read -r note_reference; do
        note_hash=${note_reference#>}
        [[ -f "$source_dir/$note_hash" ]] || continue
        cp -p -- "$source_dir/$note_hash" "$destination_dir/$note_hash" || return 1
    done < <(grep -oE '>[0-9a-f]{40}' "$todo_file" | sort -u || true)
}

persist_session_todo_notes() {
    local path=$1

    [[ -f "$path/.archcfg-persist-todos" ]] || return 0
    copy_todo_notes "$calcurse_data_dir/todo" "$path/notes" "$calcurse_data_dir/notes"
}

stop_session_processes() {
    local pid

    for pid in "$terminal_monitor_pid" "$calcurse_pid"; do
        [[ -n "$pid" ]] || continue
        # The child may already have exited; termination and wait are best effort.
        kill -TERM "$pid" 2>/dev/null || :
        wait "$pid" 2>/dev/null || :
    done
    terminal_monitor_pid=
    calcurse_pid=
}

run_calcurse() {
    local terminal launcher_pid=$BASHPID status=0
    terminal=$(tty) || return 1

    # Explicit stdin preserves keyboard input for the asynchronous child.
    calcurse -D "$session_dir" <&0 &
    calcurse_pid=$!
    (
        trap - EXIT HUP INT TERM
        while [[ -e "$terminal" ]]; do
            sleep 1
        done
        kill -HUP "$launcher_pid" 2>/dev/null || :
    ) &
    terminal_monitor_pid=$!

    # Unlike a foreground command, wait lets Bash handle trapped signals promptly.
    wait "$calcurse_pid" || status=$?
    calcurse_pid=
    stop_session_processes
    return "$status"
}

cleanup() {
    local path

    stop_session_processes
    if [[ -n "$session_dir" && -d "$session_dir" ]] && ! persist_session_todo_notes "$session_dir"; then
        printf 'Could not preserve Calcurse TODO notes; keeping recovery session: %s\n' "$session_dir" >&2
        session_dir=
    fi
    for path in "$build_dir" "$file_list" "$import_config_dir" "$session_dir"; do
        [[ -z "$path" || ! -e "$path" ]] || rm -rf -- "$path"
    done
}

cleanup_generations() {
    local current_generation
    local -a generations=()
    local -a backups=()
    local generation
    local index

    current_generation=$(readlink -f -- "$current_profile") || return 0
    shopt -s nullglob
    generations=("$generations_dir"/*)
    shopt -u nullglob

    for generation in "${generations[@]}"; do
        [[ "$generation" == "$current_generation" ]] || backups+=("$generation")
    done

    # Keep the active generation and two rollback generations.
    for ((index = 0; index < ${#backups[@]} - 2; index++)); do
        rm -rf -- "${backups[index]}"
    done
}

cleanup_stale_workdirs() {
    local path
    local owner_pid

    shopt -s nullglob
    for path in "$generations_dir"/.build.* "$state_dir"/calcurse-google-config.* "$state_dir"/calcurse-google-files.*; do
        rm -rf -- "$path"
    done

    for path in "$state_dir"/calcurse-google-session.*; do
        [[ -f "$path/.archcfg-owner-pid" ]] || continue
        owner_pid=$(<"$path/.archcfg-owner-pid")
        [[ "$owner_pid" =~ ^[0-9]+$ ]] && kill -0 "$owner_pid" 2>/dev/null && continue
        if ! persist_session_todo_notes "$path"; then
            printf 'Could not preserve Calcurse TODO notes; keeping recovery session: %s\n' "$path" >&2
            continue
        fi
        rm -rf -- "$path"
    done
    shopt -u nullglob
}

build_profile() {
    local -a calendar_files=()
    local calendar_file
    local fingerprint_file
    local generation_name
    local generation_dir
    local mirror_fingerprint
    local next_link

    if ! file_list=$(mktemp "$state_dir/calcurse-google-files.XXXXXX"); then
        printf 'Could not prepare the Google Calendar file list.\n' >&2
        return 1
    fi

    if ! find "$calendar_dir" -type f -name '*.ics' -print0 | sort -z >"$file_list"; then
        printf 'Could not read the Google Calendar mirror; keeping the last verified Calcurse view.\n' >&2
        return 1
    fi

    if ! mapfile -d '' calendar_files <"$file_list"; then
        printf 'Could not load the Google Calendar file list.\n' >&2
        return 1
    fi

    if ((${#calendar_files[@]} == 0)); then
        printf 'Google Calendar mirror has no event files; keeping the last verified Calcurse view.\n' >&2
        return 1
    fi

    if ! mirror_fingerprint=$(xargs -0 sha256sum <"$file_list" | sha256sum); then
        printf 'Could not fingerprint the Google Calendar mirror; keeping the last verified Calcurse view.\n' >&2
        return 1
    fi
    mirror_fingerprint=${mirror_fingerprint%% *}
    fingerprint_file="$current_profile/.archcfg-mirror-fingerprint"

    if [[ -f "$fingerprint_file" ]] &&
        [[ $(<"$fingerprint_file") == "$mirror_fingerprint" ]] &&
        calcurse -D "$current_profile" --read-only -G >/dev/null; then
        return 0
    fi

    if ! build_dir=$(mktemp -d "$generations_dir/.build.XXXXXX"); then
        printf 'Could not create a Calcurse Google view.\n' >&2
        return 1
    fi

    if ! import_config_dir=$(mktemp -d "$state_dir/calcurse-google-config.XXXXXX"); then
        printf 'Could not prepare the Calcurse import configuration.\n' >&2
        return 1
    fi

    print_status 34 '•' 'Updating calendar view...'

    for calendar_file in "${calendar_files[@]}"; do
        if ! calcurse -D "$build_dir" -C "$import_config_dir" -q -i "$calendar_file"; then
            printf 'Could not import a Google Calendar event; keeping the last verified Calcurse view.\n' >&2
            return 1
        fi
    done

    if { [[ ! -s "$build_dir/apts" ]] && [[ ! -s "$build_dir/todo" ]]; } ||
        ! calcurse -D "$build_dir" -C "$import_config_dir" --read-only -G >/dev/null; then
        printf 'Generated Calcurse Google view failed validation; keeping the last verified view.\n' >&2
        return 1
    fi

    if ! printf '%s\n' "$mirror_fingerprint" >"$build_dir/.archcfg-mirror-fingerprint"; then
        printf 'Could not record the Google Calendar mirror fingerprint; keeping the last verified view.\n' >&2
        return 1
    fi

    printf -v generation_name '%s-%08d' "$(date -u +%Y%m%dT%H%M%SZ)" "$$"
    generation_dir="$generations_dir/$generation_name"
    if ! mv -- "$build_dir" "$generation_dir"; then
        printf 'Could not publish the Calcurse Google view.\n' >&2
        return 1
    fi
    build_dir=

    next_link="$profile_dir/.current.$$"
    if ! ln -s "generations/$generation_name" "$next_link"; then
        printf 'Could not activate the Calcurse Google view.\n' >&2
        return 1
    fi

    if ! mv -Tf -- "$next_link" "$current_profile"; then
        rm -f -- "$next_link"
        printf 'Could not activate the Calcurse Google view.\n' >&2
        return 1
    fi

    cleanup_generations
}

prepare_reminder_profile() {
    [[ -f "$current_profile/apts" ]] || {
        printf 'No verified Google Calendar reminder view is available yet.\n' >&2
        return 1
    }

    install -dm700 "$reminder_profile" "$reminder_profile/notes" || return 1
    # Regenerate even on cache hits so local settings never select Google's notification policy.
    if ! sed '/^notification\./d' "$calcurse_config_dir/conf" >"$reminder_profile/conf.new" ||
        ! printf '%s\n' \
            'notification.command="$HOME/.local/bin/archcfg-calcurse-google-notify"' \
            'notification.notifyall=all' \
            'notification.warning=900' >>"$reminder_profile/conf.new" ||
        ! mv -f -- "$reminder_profile/conf.new" "$reminder_profile/conf"; then
        printf 'Could not prepare the Google Calendar notification configuration.\n' >&2
        return 1
    fi
    [[ -f "$reminder_profile/todo" ]] || install -m600 /dev/null "$reminder_profile/todo" || return 1
    ln -sfn ../calcurse-google/current/apts "$reminder_profile/apts"
}

prepare_session() {
    local generation

    if ! generation=$(readlink -f -- "$current_profile") || [[ ! -d "$generation" ]]; then
        printf 'No verified Google Calendar view is available yet.\n' >&2
        return 1
    fi

    if ! session_dir=$(mktemp -d "$state_dir/calcurse-google-session.XXXXXX"); then
        printf 'Could not prepare the Calcurse session.\n' >&2
        return 1
    fi

    if ! printf '%s\n' "$$" >"$session_dir/.archcfg-owner-pid"; then
        printf 'Could not prepare the Calcurse session.\n' >&2
        return 1
    fi

    if ! install -dm700 "$calcurse_data_dir" "$calcurse_data_dir/notes"; then
        printf 'Could not prepare persistent Calcurse TODOs.\n' >&2
        return 1
    fi
    if [[ ! -f "$calcurse_data_dir/todo" ]] &&
        ! install -m600 /dev/null "$calcurse_data_dir/todo"; then
        printf 'Could not prepare persistent Calcurse TODOs.\n' >&2
        return 1
    fi

    # Calendar edits stay in the disposable session while TODOs use the persistent local data file.
    if ! cp -a -- "$generation/." "$session_dir/" ||
        ! cp -a -- "$reminder_profile/conf" "$calcurse_config_dir/keys" "$session_dir/" ||
        ! rm -f -- "$session_dir/todo" ||
        ! ln -s "$calcurse_data_dir/todo" "$session_dir/todo"; then
        printf 'Could not prepare the Calcurse session.\n' >&2
        return 1
    fi

    if ! copy_todo_notes "$calcurse_data_dir/todo" "$calcurse_data_dir/notes" "$session_dir/notes" ||
        ! touch "$session_dir/.archcfg-persist-todos"; then
        printf 'Could not prepare persistent Calcurse TODOs.\n' >&2
        return 1
    fi
}

case ${1:-} in
    '')
        ;;
    --refresh)
        refresh_only=true
        shift
        ;;
    *)
        printf 'Usage: %s [--refresh]\n' "${0##*/}" >&2
        exit 2
        ;;
esac

[[ $# -eq 0 ]] || {
    printf 'Usage: %s [--refresh]\n' "${0##*/}" >&2
    exit 2
}

[[ -f "$calcurse_config_dir/conf" ]] || {
    printf 'Calcurse is not configured.\n' >&2
    exit 1
}

if ! "$refresh_only" && [[ ! -f "$calcurse_config_dir/keys" ]]; then
    printf 'Calcurse is not configured.\n' >&2
    exit 1
fi

command -v calcurse >/dev/null || {
    printf 'calcurse is not installed.\n' >&2
    exit 1
}

command -v flock >/dev/null || {
    printf 'flock is not installed.\n' >&2
    exit 1
}

umask 077
install -dm700 "$profile_dir" "$generations_dir" "$state_dir"
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if ! "$refresh_only"; then
    exec 9>"$session_lock_file"
    if ! flock -n 9; then
        printf 'Another Calcurse Google session is already running.\n' >&2
        exit 1
    fi
fi

exec 8>"$profile_lock_file"
if "$refresh_only"; then
    flock -n 8 || exit 0
else
    flock 8
fi

cleanup_stale_workdirs

print_header
print_status 33 '↻' 'Syncing calendars...'
if ! command -v vdirsyncer >/dev/null; then
    printf 'vdirsyncer is not installed; opening the last verified Calcurse view.\n' >&2
elif [[ ! -f "$vdir_config" ]]; then
    printf 'Google Calendar is not configured; opening the last verified Calcurse view.\n' >&2
elif ! vdirsyncer --config "$vdir_config" sync >/dev/null 2>&1; then
    printf 'Google Calendar sync failed; opening the last verified Calcurse view.\n' >&2
elif [[ ! -d "$calendar_dir" ]]; then
    printf 'Google Calendar mirror is unavailable; opening the last verified Calcurse view.\n' >&2
elif ! build_profile; then
    :
fi

if ! prepare_reminder_profile; then
    exit 1
fi

if "$refresh_only"; then
    exit 0
fi

if ! prepare_session; then
    exit 1
fi

rm -rf -- "$file_list" "$import_config_dir"
file_list=
import_config_dir=
flock -u 8

print_status 32 '✓' 'Calendar ready.'
printf '\n'
set +e
run_calcurse
calcurse_status=$?
set -e
exit "$calcurse_status"
